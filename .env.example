# API Keys
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
QDRANT_API_KEY=your_qdrant_api_key_here

# Model Configuration
OPENAI_MODEL=gpt-4o
STUDY_PROFILE_MODEL=gpt-4o-mini
MISTRAL_MODEL=pixtral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Embedding Configuration
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072
MAX_TOKENS_PER_CHUNK=600

# Qdrant Configuration
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_COLLECTION=exueed_kb_latest

# ============================================================
# PostgreSQL Configuration - THREE DATABASES ON SAME SERVER
# ============================================================
# All databases share the same host/port/user/password

# Main Study Details Database (display-study-details)
# - Contains: studies table for admin-uploaded documents
# - Used by: Study details display, admin ingestion
POSTGRES_HOST=34.21.60.224
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_actual_password
POSTGRES_DATABASE=display-study-details
USE_POSTGRES_FOR_STUDY_DETAILS=true

# NOTE: study-profiles database uses same credentials above
# - Contains: normalized study profiles with lookup tables (cancer_types, etc.)
# - Used by: StudyProfilesFilteringService for pre-filtering
# - Database name is hardcoded as "study-profiles" in the service

# Patients Database (exueed-patients)
# - Contains: patients, patient_diagnosis, patient_biomarkers,
#   patient_treatment_history, patient_timeline_events
# - Used by: patient record core (src/api/services/patient_db.py) — patient-centric pivot
# - Shares host/user/password with POSTGRES_* above by default; only set
#   PATIENTS_POSTGRES_PASSWORD if it differs from POSTGRES_PASSWORD
PATIENTS_POSTGRES_HOST=34.21.60.224
PATIENTS_POSTGRES_PORT=5432
PATIENTS_POSTGRES_USER=postgres
# PATIENTS_POSTGRES_PASSWORD=your_actual_password
PATIENTS_POSTGRES_DATABASE=exueed-patients
PATIENTS_POSTGRES_MIN_POOL=1
PATIENTS_POSTGRES_MAX_POOL=5

# Account Database (exueed_cache)
# - Contains: users, user_cache, user_uploads tables
# - Used by: User authentication, user uploads, caching
CACHE_POSTGRES_HOST=34.21.60.224
CACHE_POSTGRES_PORT=5432
CACHE_POSTGRES_USER=postgres
CACHE_POSTGRES_PASSWORD=your_actual_password
CACHE_POSTGRES_DATABASE=exueed_cache
CACHE_POSTGRES_MIN_POOL=1
CACHE_POSTGRES_MAX_POOL=5
CACHE_TTL_SECONDS=86400
CACHE_HOT_MAX_ENTRIES=200

# ============================================================
# GCP Configuration (optional)
# ============================================================
GCP_BUCKET_NAME=your-gcp-bucket-name
GCP_USER_UPLOADS_BUCKET=user_uploads
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json
AUTO_SYNC_GCP=false

# Processing Configuration
OUTPUT_DIR=processed_documents
CACHE_DIR=cache
TEMP_DIR=temp

# Batch Sizes
EMBED_BATCH_SIZE=64
QDRANT_BATCH_SIZE=512

# Feature Flags
ENABLE_PIXTRAL=true
ENABLE_FIGURE_EXTRACTION=true
ENABLE_TABLE_EXTRACTION=true
EXTRACT_STUDY_PROFILES=false
USE_RECONCILED_STRUCTURE=false

# Auth Configuration
AUTH_SECRET_KEY=change-me-to-a-secure-random-string
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Clinician registration gating (patient portal).
# Clinicians appear in a patient-facing directory, so registration is
# domain-gated. This is a speed bump, not identity verification.
#   blocklist = reject consumer/disposable providers (default)
#   allowlist = permit only CLINICIAN_EMAIL_ALLOWLIST
#   off       = no checking
CLINICIAN_EMAIL_MODE=blocklist
# Comma-separated, used only in allowlist mode, e.g. mskcc.org,nyu.edu
CLINICIAN_EMAIL_ALLOWLIST=
